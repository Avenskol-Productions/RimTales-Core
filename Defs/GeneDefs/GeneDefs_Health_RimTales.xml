<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef Name="RTC_GeneHealingRateBase" Abstract="True">
    <displayCategory>RTC_GeneCat</displayCategory>
    <displayOrderInCategory>7</displayOrderInCategory>
    <exclusionTags>
      <li>WoundHealingRate</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef ParentName="RTC_GeneHealingRateBase">
    <defName>WoundHealing_None_RTC</defName>
    <label>no wound healing</label>
    <labelShortAdj>no-heal</labelShortAdj>
    <description>Carriers of this gene never heal.</description>
    <iconPath>UI/Icons/Genes/Gene_WoundHealingRateSlow</iconPath>
    <statFactors>
      <InjuryHealingFactor>-1.0</InjuryHealingFactor>
    </statFactors>
    <biostatMet>4</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>pathetic</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef Name="RTC_Organ" Abstract="True">
    <displayCategory>RTC_GeneCat</displayCategory>
    <displayOrderInCategory>8</displayOrderInCategory>
    <exclusionTags>
      <li>ToxicEnvironmentResistance</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef ParentName="RTC_Organ">
    <defName>Organ_Invelize_RTC</defName>
    <label>invelize organ</label>
    <labelShortAdj>invelizing</labelShortAdj>
    <description>Carriers of this gene heal from wounds 75% slower than normal, but are however 75% more resistant to disease. They are also immune to toxins.</description>
    <iconPath>UI/Icons/Genes/Gene_SuperStrongImmunity</iconPath>
    <immuneToToxGasExposure>true</immuneToToxGasExposure>
    <statFactors>
      <InjuryHealingFactor>0.25</InjuryHealingFactor>
      <ImmunityGainSpeed>1.75</ImmunityGainSpeed>
    </statFactors>
    <statOffsets>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
    </statOffsets>
    <biostatMet>-1</biostatMet>
    <biostatCpx>4</biostatCpx>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>invelized</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef Name="RTC_ManaEnviromentResistance" Abstract="True">
    <displayCategory>RTC_GeneCat</displayCategory>
    <displayOrderInCategory>9</displayOrderInCategory>
    <exclusionTags>
      <li>ManaEnvironmentResistance</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef ParentName="RTC_ManaEnviromentResistance">
    <defName>ManaEnvironmentResistance_Partial_RTC</defName>
    <label>partial mana adaptation</label>
    <labelShortAdj>mana adaptation</labelShortAdj>
    <description>Carriers of this gene are resistant to environmental mana. They get less mana buildup from mana infused terrain, and mana fog, but are still vulnerable to spiritual attacks and mana weaponry.</description>
    <iconPath>UI/Icons/Genes/Gene_PartialPollutionResistance</iconPath>
    <statOffsets>
      <RTC_ManaEnvironmentResistance>0.5</RTC_ManaEnvironmentResistance>
    </statOffsets>
    <biostatMet>-1</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li>
          <symbol>mana</symbol>
          <weight>2</weight>
        </li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef ParentName="RTC_ManaEnviromentResistance">
    <defName>ManaEnvironmentResistance_Total_RTC</defName>
    <label>total mana adaptation</label>
    <labelShortAdj>mana adapted</labelShortAdj>
    <description>Carriers of this gene are immune to environmental mana, but not from direct mana attacks. They get no mana sickness from mana infused terrain, or mana fog, but are still vulnerable to spiritual attacks and mana weaponry.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalPollutionResistance</iconPath>
    <statOffsets>
      <RTC_ManaEnvironmentResistance>1</RTC_ManaEnvironmentResistance>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-3</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li>
          <symbol>mana</symbol>
          <weight>4</weight>
        </li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>