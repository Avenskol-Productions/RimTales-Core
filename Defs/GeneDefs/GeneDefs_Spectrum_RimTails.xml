<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef Name="RTC_ManaResistance" Abstract="True">
    <displayCategory>RTC_GeneCat</displayCategory>
    <displayOrderInCategory>11</displayOrderInCategory>
    <exclusionTags>
      <li>ManaResistance</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef ParentName="RTC_ManaResistance">
    <defName>ManaResist_Partial_RTC</defName>
    <label>mana resistance</label>
    <labelShortAdj>mana-resistant</labelShortAdj>
    <description>Carriers of this gene are resistant to mana sickness from any source. This includes mana infused terrain, mana fog, mana bombs, spiritual magic.</description>
    <iconPath>UI/Icons/Genes/Gene_PartialToxicityResistance</iconPath>
    <statOffsets>
      <RTC_ManaResistance>0.5</RTC_ManaResistance>
    </statOffsets>
    <biostatMet>-2</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li>
          <symbol>mana</symbol>
          <weight>3</weight>
        </li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef ParentName="RTC_ManaResistance">
    <defName>ManaResist_Total_RTC</defName>
    <label>mana immunity</label>
    <labelShortAdj>mana-immune</labelShortAdj>
    <description>Carriers of this gene are totally immune to mana sickness from all sources including mana infused terrain, mana fog, mana bombs, and spiritual magic.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <statOffsets>
      <RTC_ManaResistance>1</RTC_ManaResistance>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-4</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li>
          <symbol>mana</symbol>
          <weight>3</weight>
        </li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef Name="GenePainBase_RTC" Abstract="True">
    <displayCategory>RTC_GeneCat</displayCategory>
    <displayOrderInCategory>12</displayOrderInCategory>
    <exclusionTags>
      <li>Pain</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef ParentName="GenePainBase_RTC">
    <defName>Pain_Immune_RTC</defName>
    <label>pain immunity</label>
    <labelShortAdj>pain-immune</labelShortAdj>
    <description>Carriers of this gene feel no pain. This is caused by anesthetizing chemicals, causing any would be pain to feel numb. This is extremely useful for warrior like people who fight until death consumes them, but is extremely dangerous otherwise.</description>
    <iconPath>UI/Icons/Genes/Gene_SuperStrongImmunity</iconPath>
    <painFactor>0.0</painFactor>
    <biostatMet>-2</biostatMet>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>numb</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>