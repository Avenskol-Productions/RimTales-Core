<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseMakeableGrenade">
    <defName>Weapon_GrenadeMana_RTC</defName>
    <label>mana grenades</label>
    <description>mana-infused grenades. They can be thrown a short distance, where they'll explode, inflicting mana sickness to anything and anyone nearby.</description>
    <recipeMaker>
      <researchPrerequisite>Machining</researchPrerequisite>
    </recipeMaker>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Grenades</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <soundInteract>Interact_Grenade</soundInteract>
    <techLevel>Neolithic</techLevel>
    <statBases>
      <Mass>1</Mass>
      <RangedWeapon_Cooldown>2.66</RangedWeapon_Cooldown>
      <WorkToMake>12000</WorkToMake>
    </statBases>
    <costList>
      <Steel>20</Steel>
      <Chemfuel>80</Chemfuel>
    </costList>
    <weaponTags>
      <li>GrenadeMana</li>
    </weaponTags>
    <thingCategories>
      <li>Grenades</li>
    </thingCategories>
    <smeltable>true</smeltable>
    <verbs>
      <li>
        <label>throw mana grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>12.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <warmupTime>1.5</warmupTime>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>Proj_GrenadeMana_RTC</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>2.66</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
    </comps>
  </ThingDef>

  <ThingDef Name="BaseManaProjectile_RTC" ParentName="BaseGrenadeProjectile" Abstract="True">
    <thingClass>RimTalesCore.Projectile_ManaExplosion_RimTales</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Grenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <explosionRadius>1.9</explosionRadius >
      <damageDef>Bomb</damageDef>
      <damageAmountBase>5</damageAmountBase>
      <explosionDelay>100</explosionDelay>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseManaProjectile_RTC">
    <defName>Proj_GrenadeMana_RTC</defName>
    <label>mana grenade</label>
  </ThingDef>

</Defs>