<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TileMutatorDef>
    <defName>RTC_ManaLake_Acid</defName>
    <label>mana lake</label>
    <description>A body of mana that has been converted to acid mana. The mana will burn.</description>
    <categories>
      <li>Lake</li>
    </categories>
    <priority>2</priority>
    <workerClass>TileMutatorWorker_RTC_AcidManaLake</workerClass>
    <additionalGameConditions>
      <li>ManaFog_RimTales</li>
    </additionalGameConditions>
    <biomeWhitelist>
      <li>BorealForest</li>
      <li>ColdBog</li>
      <li>Glowforest</li>
      <li>TemperateForest</li>
      <li>TemperateSwamp</li>
      <li>TropicalRainforest</li>
      <li>TropicalSwamp</li>
      <li>Tundra</li>
    </biomeWhitelist>
    <canSpawnOnRiver>false</canSpawnOnRiver>
  </TileMutatorDef>

