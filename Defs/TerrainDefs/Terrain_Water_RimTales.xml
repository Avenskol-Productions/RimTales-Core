  </TerrainDef>

  <TerrainDef Abstract="True" Name="RTC_ManaShallowBase" ParentName="RTC_ManaBase">
    <pathCost>30</pathCost>
    <avoidWander>true</avoidWander>
    <waterBodyType>Freshwater</waterBodyType>
    <affordances>
      <li>ShallowWater</li>
      <li>WaterproofConduitable</li>
      <li>Bridgeable</li>
      <li>Walkable</li>
