<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <TerrainDef Abstract="True" Name="RTC_ManaBase">
    <edgeType>Water</edgeType>
    <fertility>0</fertility>
    <natural>true</natural>
    <avoidWander>true</avoidWander>
    <holdSnowOrSand>false</holdSnowOrSand>
    <takeSplashes>true</takeSplashes>
    <extinguishesFire>true</extinguishesFire>
    <extraDeteriorationFactor>3</extraDeteriorationFactor>
    <traversedThought>SoakingWet</traversedThought>
    <glowRadius>3</glowRadius>
    <glowColor>(255,255,255,0)</glowColor>
    <extraNonDraftedPerceivedPathCost>180</extraNonDraftedPerceivedPathCost>
    <extraDraftedPerceivedPathCost>18</extraDraftedPerceivedPathCost>
    <pollutionShaderType MayRequire="Ludeon.RimWorld.Biotech">TerrainWaterPolluted</pollutionShaderType>
    <pollutionOverlayTexturePath>Terrain/Surfaces/MarshPollutionOverlay</pollutionOverlayTexturePath>
    <canFreeze>false</canFreeze>
    <waterBodyType>Freshwater</waterBodyType>
    <floodTerrain MayRequire="Ludeon.RimWorld.Odyssey">ShallowFloodwater</floodTerrain>
    <throwFleckChance>0.25</throwFleckChance>
    <fleckData>
      <fleck>AirPuff</fleck>
      <velocitySpeedRange>0.01~0.5</velocitySpeedRange>
      <velocityAngleRange>-90~90</velocityAngleRange>
      <rotationSpeedRange>-50~50</rotationSpeedRange>
      <solidTicksRange>1~3</solidTicksRange>
      <scaleRange>1.5~3</scaleRange>
    </fleckData>
    <statBases>
      <Beauty>2</Beauty>
    </statBases>
    <filthAcceptanceMask>
      <li>None</li>
    </filthAcceptanceMask>
    <tags>
      <li>Water</li>
    </tags>
    <tools>
      <li>
        <label>water</label>
        <capacities>
          <li>KickMaterialInEyes</li>
        </capacities>
        <hediff>WaterInEyes</hediff>
        <cooldownTime>1.5</cooldownTime>
      </li>
    </tools>
  </TerrainDef>

  <TerrainDef Abstract="True" Name="RTC_ManaChestDeepBase" ParentName="RTC_ManaBase">
    <texturePath>Terrain/Surfaces/WaterChestDeepRamp</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/WaterChestDeepRampPolluted</pollutedTexturePath>
    <waterDepthShader>Map/WaterDepth</waterDepthShader>
    <waterBodyType>Freshwater</waterBodyType>
    <pathCost>42</pathCost>
    <affordances>
      <li>Bridgeable</li>
      <li>Walkable</li>
    </affordances>
  </TerrainDef>

  <TerrainDef ParentName="RTC_ManaChestDeepBase">
    <defName>RTC_FireManaChestDeep</defName>
    <label>chest-deep mana</label>
    <renderPrecedence>399</renderPrecedence>
    <glowColor>(255,166,0,0)</glowColor>
    <pollutedTexturePath>Terrain/Surfaces/WaterChestDeepRampPolluted</pollutedTexturePath>
    <waterDepthShaderParameters>
      <_UseWaterOffset>1</_UseWaterOffset>
    </waterDepthShaderParameters>
  </TerrainDef>

  <TerrainDef ParentName="RTC_ManaChestDeepBase">
