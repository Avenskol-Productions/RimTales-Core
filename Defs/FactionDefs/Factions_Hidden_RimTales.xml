<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>RTC_Revenant_Dark</defName>
    <label>dark revenants</label>
    <description>Nigh invulnerable demons bent on destruction.</description>
    <pawnSingular>revenant</pawnSingular>
    <pawnsPlural>revenants</pawnsPlural>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <fixedName>Revenants of Hell</fixedName>
    <factionIconPath>World/WorldObjects/Expanding/Insects</factionIconPath>
    <factionNameMaker>NamerFactionTribal</factionNameMaker>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
    <allowedCultures><li>Corunan</li></allowedCultures>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
    </disallowedMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Male_CoveringAnythingButGroinDisapproved</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_CoveringAnythingButGroinDisapproved</li>
    </disallowedPrecepts>
    <structureMemeWeights>
      <Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">11</Structure_TheistEmbodied>
    </structureMemeWeights>
    <backstoryFilters>
      <li>
        <categories>
          <li>Tribal</li>
        </categories>
      </li>
    </backstoryFilters>
    <leaderTitle>chief</leaderTitle>
    <xenotypeSet>
      <xenotypeChances>
        <RTC_Revenant_Dark MayRequire="Ludeon.RimWorld.Biotech">1.0</RTC_Revenant_Dark>
      </xenotypeChances>
    </xenotypeSet>
    <colorSpectrum>
      <li>(1.0, 0.75, 0.50)</li>
      <li>(1.0, 0.50, 0.75)</li>
      <li>(1.0, 0.50, 0.25)</li>
      <li>(1.0, 0.25, 0.50)</li>
      <li>(1.0, 0.25, 0.0)</li>
      <li>(1.0, 0.0, 0.25)</li>
      <li>(1.0, 0.0, 0.0)</li>
    </colorSpectrum>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(100,100)</li>
        <li>(10000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>1</commonality>
        <options>
          <RTC_Revenant>1</RTC_Revenant>
        </options>
      </li>
    </pawnGroupMakers>
    <humanlikeFaction>true</humanlikeFaction>
    <hidden>true</hidden>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <techLevel>Neolithic</techLevel>
    <permanentEnemyToEveryoneExcept>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Insect</li>
    </permanentEnemyToEveryoneExcept>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <allowedArrivalTemperatureRange>-15~45</allowedArrivalTemperatureRange>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>2000</configurationListOrderPriority>
  </FactionDef>

</Defs>
